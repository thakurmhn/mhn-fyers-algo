    if institutional_continuation_long(candles_3m, ema_fast, r3, atr):
        return "CALL", "INST_CONTINUATION"

    if institutional_continuation_short(candles_3m, ema_fast, s3, atr):
        return "PUT", "INST_CONTINUATION"

