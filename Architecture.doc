# ✅ Step 1 — Meta Controller Function

```python
def meta_controller(day_type, auction_state, regime):

    meta = {
        "size_factor": 1.0,
        "sl_mult": 1.0,
        "target_mult": 1.0,
        "trail_aggression": 1.0,
        "allow_add": False,
        "allow_partial": True
    }

    # ======================
    # TREND DAY LOGIC
    # ======================
    if day_type == "TREND":

        if auction_state.name == "EXPANSION":
            meta["size_factor"] = 1.5
            meta["target_mult"] = 1.8
            meta["trail_aggression"] = 0.6
            meta["allow_add"] = True

        elif auction_state.name == "ACCEPTANCE":
            meta["trail_aggression"] = 1.2

    # ======================
    # NORMAL DAY
    # ======================
    elif day_type == "NORMAL":

        meta["size_factor"] = 1.0
        meta["target_mult"] = 1.2

    # ======================
    # RANGE DAY
    # ======================
    elif day_type == "RANGE":

        meta["size_factor"] = 0.6
        meta["target_mult"] = 0.8
        meta["allow_add"] = False

    # ======================
    # EXHAUSTION PROTECTION
    # ======================
    if auction_state.name == "EXHAUSTION":
        meta["size_factor"] = 0.3
        meta["allow_add"] = False
        meta["allow_partial"] = True
        meta["trail_aggression"] = 2.0

    return meta
```

---

# ✅ Step 2 — Apply Inside Entry

In `paper_order()` / `real_order()` BEFORE building SL/TG:

```python
meta = meta_controller(day_type, auction_state, regime)
```

---

