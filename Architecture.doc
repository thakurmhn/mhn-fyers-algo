if sweep:
    sweep_type, level = sweep

    if sweep_type == "SELL_SWEEP":
        confidence += 3
        return ("CALL", f"Liquidity Sweep Long @ {level}")

    if sweep_type == "BUY_SWEEP":
        confidence += 3
        return ("PUT", f"Liquidity Sweep Short @ {level}")
```

