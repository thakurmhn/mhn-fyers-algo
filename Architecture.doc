# ✅ Step 1 — Time Phase Engine

Add this function.

```python
from datetime import time
import pendulum as dt

def get_market_phase(now=None):

    if now is None:
        now = dt.now(time_zone).time()

    if time(9,15) <= now < time(9,45):
        return "OPEN_DRIVE"

    elif time(9,45) <= now < time(11,30):
        return "DISCOVERY"

    elif time(11,30) <= now < time(13,45):
        return "MIDDAY"

    elif time(13,45) <= now < time(14,45):
        return "BUILDUP"

    elif time(14,45) <= now <= time(15,30):
        return "CLOSE"

    return "OFFMARKET"
```

