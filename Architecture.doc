✅ Step 2 — Classification Logic
def classify_opening_drive(candles):

    first_open = candles[0].open
    high = max(c.high for c in candles)
    low  = min(c.low for c in candles)
    last_close = candles[-1].close

    total_range = high - low
    net_move = last_close - first_open

    if total_range == 0:
        return "NEUTRAL"

    drive_ratio = abs(net_move) / total_range

    # strong directional conviction
    if drive_ratio > 0.7:
        if net_move > 0:
            return "OD_UP"
        else:
            return "OD_DOWN"

    # rejection behaviour
    if abs(net_move) < total_range * 0.2:
        return "OD_REVERSAL"

    return "OD_BALANCE"


